<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/asphalt_black"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEND SIGNAL"
        android:textColor="@color/pure_white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TAP TO ALERT YOUR PACK"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:paddingBottom="28dp" />

    <!-- Emergency Stop -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmergency"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="EMERGENCY STOP"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:textColor="@color/pure_white"
        app:backgroundTint="#FFD9383A"
        app:cornerRadius="6dp"
        app:icon="@drawable/ic_motorcycle"
        app:iconTint="@color/pure_white"
        app:iconSize="28dp"
        app:iconGravity="textStart"
        android:layout_marginBottom="12dp" />

    <!-- Regroup -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="REGROUP AT NEXT STOP"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:textColor="@color/pure_white"
        app:backgroundTint="@color/caution_amber"
        app:cornerRadius="6dp"
        app:icon="@drawable/ic_motorcycle"
        app:iconTint="@color/pure_white"
        app:iconSize="28dp"
        app:iconGravity="textStart"
        android:layout_marginBottom="12dp" />

    <!-- Acknowledged -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAck"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="ALL GOOD — ACK"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:textColor="@color/pure_white"
        app:backgroundTint="@color/success_green"
        app:cornerRadius="6dp"
        app:icon="@drawable/ic_motorcycle"
        app:iconTint="@color/pure_white"
        app:iconSize="28dp"
        app:iconGravity="textStart"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CLOSE"
        android:textSize="13sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/divider"
        android:textColor="@color/text_secondary" />

</LinearLayout>
