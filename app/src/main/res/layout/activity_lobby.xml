<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt_black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- App name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PACKTRACK"
            android:textColor="@color/racer_red"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvRiderGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tvAppName"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Mode buttons -->
        <LinearLayout
            android:id="@+id/layoutModeButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@+id/tvRiderGreeting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateRide"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="CREATE RIDE"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                app:backgroundTint="@color/racer_red"
                app:cornerRadius="4dp"
                android:textColor="@color/pure_white" />

            <View android:layout_width="12dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinRide"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="JOIN RIDE"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/racer_red"
                android:textColor="@color/racer_red" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  CREATE PANEL                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/panelCreate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutModeButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- PIN display -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR RIDE PIN"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvGeneratedPin"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center"
                android:textColor="@color/racer_red"
                android:textSize="56sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.3"
                android:background="@color/surface_dark"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share this PIN with your pack"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Destination search field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESTINATION"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDestination"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/racer_red"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDestination"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="City, landmark or address"
                        android:textColor="@color/pure_white"
                        android:textColorHint="@color/text_secondary"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchDest"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="FIND"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="@color/racer_red"
                    app:cornerRadius="4dp"
                    android:textColor="@color/pure_white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

            <!-- Loading indicator -->
            <LinearLayout
                android:id="@+id/layoutSearchLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/racer_red"
                    style="?android:attr/progressBarStyle" />

                <TextView
                    android:id="@+id/tvSearchStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Search results list -->
            <LinearLayout
                android:id="@+id/layoutSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_dark"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Selected destination chip -->
            <LinearLayout
                android:id="@+id/layoutDestSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/surface_dark"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/success_green" />

                <TextView
                    android:id="@+id/tvSelectedDest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/pure_white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/tvChangeDest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHANGE"
                    android:textColor="@color/racer_red"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:layout_marginStart="12dp"
                    android:padding="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchRide"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="LAUNCH RIDE"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="24dp"
                app:backgroundTint="@color/racer_red"
                app:cornerRadius="4dp"
                android:textColor="@color/pure_white"
                android:enabled="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  JOIN PANEL                                            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/panelJoin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutModeButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENTER RIDE PIN"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/racer_red"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etJoinPin"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:hint="0000"
                    android:textColor="@color/racer_red"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="number"
                    android:textSize="52sp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:maxLength="4"
                    android:letterSpacing="0.4" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/layoutJoinLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/racer_red"
                    style="?android:attr/progressBarStyle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Looking up ride..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinConfirm"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="JOIN PACK"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="20dp"
                app:backgroundTint="@color/racer_red"
                app:cornerRadius="4dp"
                android:textColor="@color/pure_white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
