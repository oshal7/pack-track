<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt_black"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PACKTRACK"
        android:textColor="@color/racer_red"
        android:textSize="42sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
        android:layout_marginTop="80dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MOTORCYCLE GROUP TRACKING"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@+id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <View
        android:id="@+id/divider"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="@color/racer_red"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRiderName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        app:boxStrokeColor="@color/racer_red"
        app:hintTextColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRiderName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="YOUR RIDER NAME"
            android:textColor="@color/pure_white"
            android:textColorHint="@color/text_secondary"
            android:inputType="textPersonName"
            android:textSize="18sp"
            android:letterSpacing="0.1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="START RIDING"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:layout_marginTop="24dp"
        app:backgroundTint="@color/racer_red"
        app:cornerRadius="4dp"
        android:textColor="@color/pure_white"
        app:layout_constraintTop_toBottomOf="@+id/tilRiderName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
