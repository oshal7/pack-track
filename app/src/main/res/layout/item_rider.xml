<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Status dot -->
    <View
        android:id="@+id/viewStatusDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@color/success_green"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Rider name -->
    <TextView
        android:id="@+id/tvRiderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/pure_white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/viewStatusDot"
        app:layout_constraintEnd_toStartOf="@+id/tvRiderDist"
        android:layout_marginStart="12dp" />

    <!-- Status label -->
    <TextView
        android:id="@+id/tvRiderStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/success_green"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@+id/tvRiderName"
        app:layout_constraintStart_toEndOf="@+id/viewStatusDot"
        app:layout_constraintEnd_toStartOf="@+id/tvNudge"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp" />

    <!-- Distance to destination -->
    <TextView
        android:id="@+id/tvRiderDist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Nudge badge -->
    <TextView
        android:id="@+id/tvNudge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/pure_white"
        android:textSize="10sp"
        android:fontFamily="sans-serif-black"
        android:background="@color/racer_red"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tvRiderName"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
