<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PackTrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/racer_red</item>
        <item name="colorPrimaryDark">@color/asphalt_black</item>
        <item name="colorAccent">@color/racer_red</item>
        <item name="android:windowBackground">@color/asphalt_black</item>
        <item name="android:statusBarColor">@color/asphalt_black</item>
        <item name="android:navigationBarColor">@color/asphalt_black</item>
        <item name="android:textColorPrimary">@color/pure_white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.PackTrack.Fullscreen" parent="Theme.PackTrack">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
